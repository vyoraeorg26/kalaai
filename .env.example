NODE_ENV=development
PORT=3000

# Use a persistent MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/kalaai

# Generate a unique random secret (at least 32 characters).
JWT_SECRET=gdsufifdsfhgishfdihgifsdgighfsdhsgiuhseiruhiweghtjhfbfdsuksyvgu
ADMIN_USERNAME=kalaai
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_DAYS=1

# Canonical public HTTPS origin, without a trailing slash.
SITE_URL=https://your-domain.vercel.app

# Vercel sets its trusted proxy headers automatically.
# Set true only for a trusted reverse proxy in non-Vercel hosting.
TRUST_PROXY=false

# Razorpay test keys first; live keys are accepted after your payment go-live checks. Keep secrets in Vercel Environment Variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Fixed shipping fee in INR, e.g. 99.00
SHIPPING_FEE_INR=

# Optional admin WhatsApp notifications (Meta WhatsApp Cloud API).
# Create and approve a Utility template with seven body placeholders; setup notes are in README.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_TO=
WHATSAPP_TEMPLATE_NAME=kalaai_checkout_notice
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v22.0
